{
  "name": "home-pc-static-server",
  "version": "2.0.0",
  "description": "Simple static website server for home PC hosting",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint .",
    "test": "npm run lint && node --check server.js && node --test tests/*.mjs web/js/*.test.cjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
