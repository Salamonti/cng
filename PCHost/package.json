  "author": "",
  "license": "MIT",
  "devDependencies": {
    "cssnano": "^8.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-html": "^8.1.4",
    "globals": "^17.9.0",
    "terser": "^5.48.0"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
