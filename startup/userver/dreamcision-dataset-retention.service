[Unit]
Description=DreamCision dataset/JSONL retention enforcement (M-3: purge old training logs, rotate missed questions)
After=network-online.target dreamcision-fastapi.service
OnFailure=telegram-alert@%n.service

[Service]
Type=oneshot
User=eissa
WorkingDirectory=/opt/dreamcision/Clinical-Note-Generator
ExecStart=/opt/dreamcision/Clinical-Note-Generator/.venv/bin/python tools/rotate_dataset_logs.py
TimeoutStartSec=30m
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
