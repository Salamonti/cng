[Unit]
Description=DreamCision nightly backup (auth+encounters DB, ASR audio, RAG chroma_store)
After=network-online.target
OnFailure=telegram-alert@%n.service

[Service]
Type=oneshot
User=eissa
WorkingDirectory=/opt/dreamcision
ExecStart=/opt/dreamcision/ops/backup_dreamcision.sh
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
